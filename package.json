{
  "name": "robohorse",
  "version": "1.0.0",
  "description": "A side-scrolling action game where you control RoboHorse, a six-legged cyber-horse, against the invading Cephalopod Armada!",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "vite",
    "setup-db": "node api/db/setup.js",
    "build": "vite build",
    "deploy": "pnpm build",
    "deploy:prod": "pnpm deploy && node scripts/deploy-frontend.js && pnpm post-deploy",
    "post-deploy": "echo '\n\u26a0\ufe0f  REMINDER: Make sure to check/update the .env file on the server if needed.\n   ssh apprunner@games.smoxu.com\n   cd /var/www/games.smoxu.com/robohorse\n   nano .env\n'",
    "test": "node --test test/*.test.js",
    "dev:api": "node --watch api/server.js",
    "typecheck": "tsc --noEmit && tsc -p cloudflare/tsconfig.json",
    "test:e2e": "playwright test",
    "release": "node scripts/release.js",
    "verify:release": "node scripts/verify-release.js",
    "build:cloudflare": "pnpm build && node scripts/build-cloudflare.js",
    "dev:cloudflare": "pnpm build:cloudflare && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --env \"\"",
    "db:cloudflare:local": "wrangler d1 migrations apply DB --local",
    "check:cloudflare": "pnpm build:cloudflare && wrangler deploy --dry-run --env \"\"",
    "test:cloudflare": "playwright test -c playwright.cloudflare.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmyazin/Robohorse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vmyazin/Robohorse/issues"
  },
  "homepage": "https://github.com/vmyazin/Robohorse#readme",
  "dependencies": {
    "alpinejs": "^3.15.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "express": "^5.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  }
}
