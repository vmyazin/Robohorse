{
  "name": "robohorse",
  "version": "1.0.0",
  "description": "A side-scrolling action game where you control RoboHorse, a six-legged cyber-horse, against the invading Cephalopod Armada!",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "vite",
    "setup-db": "node api/db/setup.js",
    "build": "vite build",
    "deploy": "pnpm build",
    "deploy:prod": "pnpm deploy && node scripts/deploy-frontend.js && pnpm post-deploy",
    "post-deploy": "echo '\n\u26a0\ufe0f  REMINDER: Make sure to check/update the .env file on the server if needed.\n   ssh apprunner@games.smoxu.com\n   cd /var/www/games.smoxu.com/robohorse\n   nano .env\n'",
    "test": "node --test",
    "dev:api": "node --watch api/server.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vmyazin/Robohorse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vmyazin/Robohorse/issues"
  },
  "homepage": "https://github.com/vmyazin/Robohorse#readme",
  "dependencies": {
    "alpinejs": "^3.15.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  }
}
