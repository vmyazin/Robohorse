{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robohorse",
  "account_id": "7f64edc36bdefec27b66e6ff9b2dcc3d",
  "main": "cloudflare/worker.ts",
  "routes": [
    { "pattern": "games.smoxu.com/robohorse/*", "zone_name": "smoxu.com" },
    { "pattern": "games.smoxu.com/robohorse", "zone_name": "smoxu.com" }
  ],
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./.cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/robohorse", "/api/*", "/robohorse/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "robohorse-scores",
    "database_id": "4e0a9dcf-a4f4-4ae8-90bb-071e0338e800",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [{
    "name": "SCORE_LIMITER",
    "namespace_id": "4270",
    "simple": { "limit": 10, "period": 60 }
  }],
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "robohorse-preview",
      "routes": [],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "robohorse-scores-preview",
        "database_id": "099b0bda-3658-4c8b-97bf-16853b375f3e",
        "migrations_dir": "cloudflare/migrations"
      }],
      "ratelimits": [{
        "name": "SCORE_LIMITER",
        "namespace_id": "4271",
        "simple": { "limit": 10, "period": 60 }
      }]
    }
  }
}
