{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "skipLibCheck": true
  },
  "include": ["frontend/js/**/*.ts", "api/**/*.ts"]
}
